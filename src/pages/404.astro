---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/geist/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { htmlLang, locales, localePath } from '../i18n';

// GitHub Pages serves this for any missing path under the site. No new copy: the name and the three language routes.
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Victor Caldeira | Product &amp; Software Engineering</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main class="nf wrap">
      <h1 class="h2">Victor Caldeira</h1>
      <ul class="nf__links">
        {locales.map((l) => (
          <li>
            <a class="btn btn--ghost" href={localePath(l)} hreflang={htmlLang[l]} lang={htmlLang[l]}>
              {l.toUpperCase()}
            </a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>

<style>
  .nf {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 32px;
    text-align: center;
  }
  .nf__links {
    display: flex;
    gap: 12px;
  }
</style>
