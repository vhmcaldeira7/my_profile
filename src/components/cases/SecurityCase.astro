---
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const t = useTranslations(Astro.props.lang);
const hex = '12,2 20.7,7 20.7,17 12,22 3.3,17 3.3,7';
---

<article class="panel wrap" id="caso-pci">
  <div class="container">
    <div class="panel__body">
      <h3 class="panel__title">{t('pc.t')}</h3>
      <p class="panel__meta">{t('pc.meta')}</p>
      <p class="panel__lede">{t('pc.lede')}</p>
      <figure class="certs" id="certs" aria-labelledby="certs-cap">
        <figcaption class="flow__cap">
          <span id="certs-cap">{t('pc.cap')}</span>
          <ul class="flow__legend" aria-hidden="true">
            <li>
              <svg viewBox="0 0 12 12" width="12" height="12">
                <polygon class="lg-cert" points="6,1 10.3,3.5 10.3,8.5 6,11 1.7,8.5 1.7,3.5" />
              </svg>
              <span>{t('lg.cert')}</span>
            </li>
            <li>
              <svg viewBox="0 0 12 12" width="12" height="12">
                <circle class="lg-prog" cx="6" cy="6" r="4.2" />
              </svg>
              <span>{t('lg.prog')}</span>
            </li>
          </ul>
        </figcaption>
        <ol class="certs__track" aria-hidden="true">
          <li class="cert">
            <span class="cert__mark">
              <svg viewBox="0 0 24 24">
                <polygon points={hex} />
              </svg>
            </span>
            <b class="cert__name">{t('pc.cmmi')}</b>
            <span class="cert__co">DB1 · 2016–2021</span>
          </li>
          <li class="cert">
            <span class="cert__mark">
              <svg viewBox="0 0 24 24">
                <polygon points={hex} />
              </svg>
            </span>
            <b class="cert__name">ISO 27001</b>
            <span class="cert__co">ANYMARKET · 2021–2024</span>
          </li>
          <li class="cert">
            <span class="cert__mark">
              <svg viewBox="0 0 24 24">
                <polygon points={hex} />
              </svg>
            </span>
            <b class="cert__name">PCI DSS</b>
            <span class="cert__co">Greenn Pagamentos · 2025–2026</span>
            <i class="cert__role">{t('pc.r1')}</i>
          </li>
          <li class="cert cert--prog">
            <span class="cert__mark">
              <svg viewBox="0 0 24 24">
                <circle class="cert__ring" cx="12" cy="12" r="8" />
                <circle cx="12" cy="12" r="8" />
                <circle class="cert__dot" cx="12" cy="12" r="2.5" />
              </svg>
            </span>
            <b class="cert__name">{t('pc.soc')}</b>
            <span class="cert__co">Greenn Pagamentos · 2025–2026</span>
            <i class="cert__role">{t('pc.r2')}</i>
          </li>
        </ol>
        <ol class="sr-only">
          <li>{t('pc.s1')}</li>
          <li>{t('pc.s2')}</li>
          <li>{t('pc.s3')}</li>
          <li>{t('pc.s4')}</li>
        </ol>
      </figure>
    </div>
  </div>
</article>

<style>
  /* the certs timeline: four marks on one rail across three houses; the last one, the SOC, keeps pulsing */
  .certs {
    margin: 22px 0 0;
    padding: 12px 14px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
  }
  .certs__track {
    --draw: 1;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 14px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .certs__track::before,
  .certs__track::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    top: 11.5px;
    height: 1px;
    background: var(--line-strong);
  }
  .certs__track::after {
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(var(--draw));
  }
  .cert {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'mark' 'name' 'co' 'role';
    align-content: start;
    row-gap: 3px;
    min-width: 0;
  }
  .cert__mark {
    grid-area: mark;
    position: relative;
    z-index: 1;
    width: 24px;
    height: 24px;
    margin-bottom: 7px;
  }
  .cert__mark svg {
    display: block;
    width: 24px;
    height: 24px;
    overflow: visible;
  }
  .cert__mark :is(polygon, circle) {
    fill: var(--surface);
    stroke: var(--text);
    stroke-width: 1.5;
    stroke-linejoin: round;
    transition:
      fill 0.35s,
      stroke 0.35s;
  }
  .cert:global(.is-on) .cert__mark polygon {
    fill: var(--accent-fill);
    stroke: var(--accent);
  }
  .cert:global(.is-on) .cert__mark circle {
    stroke: var(--accent);
  }
  .cert__mark .cert__dot {
    fill: var(--text);
    stroke: none;
  }
  .cert:global(.is-on) .cert__mark .cert__dot {
    fill: var(--accent-fill);
  }
  .cert__mark .cert__ring {
    fill: none;
    stroke: var(--accent);
    opacity: 0;
  }
  .cert__name {
    grid-area: name;
    font-family: var(--font-display);
    font-weight: 650;
    font-stretch: 80%;
    font-size: 1.125rem;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .cert__co {
    grid-area: co;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.35;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .cert__role {
    grid-area: role;
    font-size: 0.75rem;
    line-height: 1.35;
    font-style: normal;
    color: var(--text-dim);
  }
  .cert__name,
  .cert__co,
  .cert__role {
    transition:
      opacity 0.35s,
      transform 0.45s var(--ease-out);
  }
  .certs:global(.is-live) .cert:not(:global(.is-on)) :is(.cert__name, .cert__co, .cert__role) {
    opacity: 0;
    transform: translateY(6px);
  }
  @media (max-width: 559px) {
    .certs__track {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 16px;
    }
    .certs__track::before,
    .certs__track::after {
      left: 11.5px;
      right: auto;
      top: 12px;
      bottom: 12px;
      width: 1px;
      height: auto;
    }
    .certs__track::after {
      transform-origin: 50% 0;
      transform: scaleY(var(--draw));
    }
    .cert {
      grid-template-columns: 24px minmax(0, 1fr);
      grid-template-areas: 'mark name' 'mark co' 'mark role';
      column-gap: 12px;
      row-gap: 2px;
      align-items: start;
    }
    .cert__mark {
      margin-bottom: 0;
    }
    .cert__name {
      padding-top: 3px;
    }
  }
  @media (min-width: 900px) and (max-height: 820px) {
    .certs {
      margin-top: 14px;
      padding-block: 10px 8px;
    }
  }
</style>
