<style>
  /* the latam map: seven countries light up north to south, three acquisitions ride their arcs into one team */
  .desafios {
    display: grid;
  }
  .latam {
    margin: 22px 0 0;
    padding: 12px 14px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
  }
  .latam__stage {
    margin-top: 10px;
  }
  .latam__stage svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100dvh - 260px);
    margin-inline: auto;
    overflow: visible;
  }
  .latam svg text {
    font-family: var(--font-mono);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .lm-c {
    fill: var(--surface-2);
    stroke: var(--line-strong);
    stroke-width: 0.6;
    stroke-linejoin: round;
    transition:
      fill 0.45s,
      stroke 0.45s;
  }
  .lm-c--on {
    fill: color-mix(in srgb, var(--accent-fill) 22%, var(--surface-2));
    stroke: var(--accent);
    stroke-width: 0.8;
  }
  .lm-name {
    font-size: 11.5px;
    fill: var(--text);
    letter-spacing: 0.02em;
  }
  .lm-tag {
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--text-faint);
  }
  .lm-hub-t {
    font-size: 11.5px;
    fill: var(--accent);
    font-weight: 500;
  }
  .latam:global(.latam--s) :is(.lm-name, .lm-hub-t) {
    font-size: 14px;
  }
  .latam:global(.latam--s) .lm-tag {
    font-size: 11.5px;
  }
  .lm-arc {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .lm-arc-t {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
  }
  .lm-int {
    fill: var(--surface);
    stroke: var(--text);
    stroke-width: 1.25;
  }
  .lm-org {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 1.25;
  }
  .lm-core {
    fill: var(--accent-fill);
    stroke: var(--bg);
    stroke-width: 1;
  }
  .lm-ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    opacity: 0;
  }
  .lm-pkt {
    visibility: hidden;
  }
  .lm-pkt:global(.is-on) {
    visibility: visible;
  }
  .lm-pkt rect {
    fill: var(--accent-fill);
    stroke: var(--bg);
    stroke-width: 1;
  }
  :is(.lm-name, .lm-tag, .lm-int, .lm-org, .lm-hub, .lm-hub-t) {
    transition: opacity 0.35s;
  }
  .latam:global(.is-live) .lm-c--on:not(:global(.is-on)) {
    fill: var(--surface-2);
    stroke: var(--line-strong);
    stroke-width: 0.6;
  }
  .latam:global(.is-live) :is(.lm-name, .lm-tag, .lm-int, .lm-org, .lm-hub, .lm-hub-t):not(:global(.is-on)) {
    opacity: 0;
  }
  @media (min-width: 900px) {
    .desafios {
      grid-template-columns: minmax(0, 36rem) minmax(0, 1fr);
      column-gap: clamp(32px, 4vw, 80px);
      align-items: center;
    }
    .desafios .latam {
      margin-top: 0;
    }
    .desafios .gains {
      gap: 14px 24px;
    }
  }
  @media (min-width: 900px) and (max-height: 820px) {
    .latam {
      padding-block: 10px 6px;
    }
  }
</style>
